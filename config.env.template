# Radio Recorder Configuration Template
# Copy this file to config.env and customize for your deployment

# REQUIRED: Radio stream URL to record from
STREAM_URL=http://radio-stream.example.com/live

# REQUIRED: S3 bucket name for storing recordings
S3_BUCKET=my-radio-archive

# Recording segment duration in minutes (default: 60)
SEGMENT_MINUTES=5

# Local working directory for recordings (default: /mnt/recordings)
OUTPUT_DIR=/mnt/recordings

# Disk cleanup threshold percentage (default: 80)
MAX_DISK_USAGE_PERCENT=80

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# AWS Region (optional, uses instance metadata if not set)
AWS_DEFAULT_REGION=us-east-1

# CloudWatch namespace for custom metrics (default: RadioRecorder)
CLOUDWATCH_NAMESPACE=RadioRecorder

# Reconnection settings (advanced)
INITIAL_RECONNECT_DELAY=5
MAX_RECONNECT_DELAY=30
RECONNECT_MULTIPLIER=2
MAX_RECONNECT_ATTEMPTS=10

# Multipart upload threshold in bytes (default: 100MB)
MULTIPART_THRESHOLD=104857600
