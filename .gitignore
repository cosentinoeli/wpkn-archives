# Dependencies
node_modules/

# TypeScript
*.js
*.d.ts
*.js.map
dist/
lib/**/*.js
bin/**/*.js
test/**/*.js

# Allow JavaScript files in docs and frontend folders
!docs/**/*.js
!docs/js/*.js
!docs/**/*.css
!docs/**/*.html
!frontend/**/*.js
!frontend/**/*.css
!frontend/**/*.html

# CDK
cdk.out/
cdk.context.json
cdk-outputs.json
.cdk.staging/
*.tabl.json

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables and secrets
.env
.env.*
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
secrets.json
config.local.json

# API Keys and credentials (in case accidentally created)
**/google-credentials.json
**/aws-credentials.json
**/*-key.json
**/*-secret.json

